# Variables de la instancia (las lee Compose con --env-file; ./deltactl lo hace por ti).
# NUNCA subas este archivo ya completado: instances/ está en .gitignore.

# Nombre de la instancia. Define el proyecto Compose y los nombres de contenedor
# (s0_<INSTANCE>, s1_<INSTANCE>, robin_<INSTANCE>). Solo minúsculas, números y guion; empieza con letra.
INSTANCE=

# Registry de las imágenes (sin barra final). DÉJALO VACÍO si las imágenes ya están cargadas en el
# Docker de este servidor (docker load / ./deltactl load): se usan como backend-s0:<tag> y no se baja nada.
# Con un valor (ej. registry.ejemplo.com/itc) se usa <registry>/backend-s0:<tag> y deploy hace pull.
REGISTRY=

# Servicios activos en esta instancia, separados por coma (s0 = auth, s1 = gueo, robin = Robin).
# Ejemplos: s0,s1,robin (los tres) | s0,s1 | s1 (solo Gue) | s0 (solo Auth). Un servicio que no esté
# aquí no se descarga ni se levanta. Para detener uno que ya corre: ./deltactl stop <instancia> <sN>
COMPOSE_PROFILES=s0,s1

# Nombre de la imagen de cada servicio, SIN etiqueta ni registry (esos van aparte). Estos son los valores
# por defecto; cámbialos solo si construiste las imágenes con otro nombre (minúsculas, números y . _ - ;
# admite / para rutas). Si no existe una imagen con ese nombre y etiqueta, ./deltactl deploy se detiene.
S0_IMAGE=backend-s0
S1_IMAGE=backend-s1
ROBIN_IMAGE=backend-robin

# Etiquetas de imagen a desplegar. Usa una etiqueta por versión o commit, nunca "latest".
S0_TAG=
S1_TAG=
ROBIN_TAG=

# Puertos del host (se publican solo en 127.0.0.1). Cada instancia usa un bloque de 10
# desde 4100: la 1.ª es 4100/4101/4102, la 2.ª 4110/4111/4112... ./deltactl new propone el siguiente libre.
S0_PORT=4100
S1_PORT=4101
ROBIN_PORT=4102

# Límites de memoria por contenedor. Ajusta según la carga real.
S0_MEM_LIMIT=110m
S1_MEM_LIMIT=400m
ROBIN_MEM_LIMIT=256m

# (Opcional) Carpeta de datos. Por defecto: ./instances/<INSTANCE>/data
# DATA_DIR=
