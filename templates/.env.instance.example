# Variables de la instancia (las lee Compose con --env-file; ./itc lo hace por ti).
# NUNCA subas este archivo ya completado: instances/ está en .gitignore.

# Nombre de la instancia. Define el proyecto Compose y los nombres de contenedor
# (s0_<INSTANCE>, s1_<INSTANCE>). Solo minúsculas, números y guion; empieza con letra.
INSTANCE=

# Registry de las imágenes (sin barra final). DÉJALO VACÍO si las imágenes ya están cargadas en el
# Docker de este servidor (docker load / ./itc load): se usan como auth-backend:<tag> y no se baja nada.
# Con un valor (ej. registry.ejemplo.com/itc) se usa <registry>/auth-backend:<tag> y deploy hace pull.
REGISTRY=

# Servicios activos en esta instancia, separados por coma (s0 = auth, s1 = gueo).
# Ejemplos: s0,s1 (los dos) | s1 (solo Gue) | s0 (solo Auth). Un servicio que no esté
# aquí no se descarga ni se levanta. Para detener uno que ya corre: ./itc stop <instancia> <sN>
COMPOSE_PROFILES=s0,s1

# Nombre de la imagen de cada servicio, SIN etiqueta ni registry (esos van aparte). Estos son los valores
# por defecto; cámbialos solo si construiste las imágenes con otro nombre (minúsculas, números y . _ - ;
# admite / para rutas). Si no existe una imagen con ese nombre y etiqueta, ./itc deploy se detiene.
S0_IMAGE=auth-backend
S1_IMAGE=gueo-back-end

# Etiquetas de imagen a desplegar. Usa una etiqueta por versión o commit, nunca "latest".
S0_TAG=
S1_TAG=

# Puertos del host (se publican solo en 127.0.0.1). Cada instancia usa un bloque de 10
# desde 4100: la 1.ª es 4100/4101, la 2.ª 4110/4111... ./itc new propone el siguiente libre.
S0_PORT=4100
S1_PORT=4101

# Límites de memoria por contenedor. Ajusta según la carga real.
S0_MEM_LIMIT=512m
S1_MEM_LIMIT=2g

# (Opcional) Carpeta de datos. Por defecto: ./instances/<INSTANCE>/data
# DATA_DIR=
