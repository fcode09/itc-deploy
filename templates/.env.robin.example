# robin = backend-robin (Robin) — variables de entorno de esta instancia.
# Basado en el código de robin-backend (no trae .env.example); cada variable está descrita en
# `./deltactl help variable <NOMBRE>`. NUNCA subas valores reales.
#
# SERVER_PORT no va aquí: lo fija el compose (3601).
# Dentro del contenedor 127.0.0.1 es el propio contenedor.


# --- Autenticación (único por instancia) ---
# El MISMO valor que s0 y s1: Robin valida con él los tokens que emite s0. Sin esta variable el código
# usa un valor por defecto conocido, así que aquí es obligatoria.
JWT_SECRET=
JWT_EXPIRES_IN=8h


# --- Base de datos ---
# MongoDB del servidor, visto desde el contenedor. Debe ser la MISMA base que MONGO_ROBIN_URI de s1.
ROBIN_MONGO_URI=mongodb://host.docker.internal:27017/CAMBIAR_robin_INSTANCIA


# --- Kafka (en el host, no en este compose) ---
KAFKA_BROKER_IP=host.docker.internal
KAFKA_BROKER_PORT=9092
# Tópico del que Robin lee las tramas. Sin valor la suscripción no se crea.
KAFKA_TOPIC=CAMBIAR-topic-de-kafka
# Un grupo por instancia: con el mismo grupo, dos instancias se repartirían los mensajes en vez de
# recibirlos los dos.
KAFKA_GROUP_ID=CAMBIAR_robin_INSTANCIA


# --- Conexión con s1 (Delta Dispatch) ---
# Robin le pide los turnos y los polígonos. Dentro de la red privada de la instancia, s1 se resuelve por
# el nombre del servicio. Si s1 no corre en esta instancia, apunta aquí al Delta Dispatch que corresponda.
DELTA_DISPATCH_URL=http://s1:3000


# --- Reportes (Query Forge) ---
# Sin estas dos variables los reportes de metas fallan; el resto de Robin funciona.
QUERY_FORGE_URL=
QUERY_FORGE_API_KEY=


# --- Envío a SIPCOPM (Link) ---
# Sin valor se usa el que está guardado en la configuración de la municipalidad (en la base).
URI_SIPCOPM=
POLICE_URI_SIPCOPM=
SIPCOP_MAX_CONCURRENT=10


# --- Conversor geográfico ---
# Servicio de direcciones que Robin consulta por TCP. Por defecto el propio contenedor (no hay ninguno
# ahí): si corre en el host, usa host.docker.internal.
IP_INTERNAL_CONNECTION=127.0.0.1
PORT_INTERNAL_CONNECTION=7050


# --- Cola de entrada (valores del código; ajústalos solo si la carga lo pide) ---
QUEUE_MAX_SIZE=40
QUEUE_RESUME_THRESHOLD=30
QUEUE_BATCH_SIZE=20
QUEUE_POLL_INTERVAL_MS=1000
