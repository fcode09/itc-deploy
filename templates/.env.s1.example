# s1 = backend-s1 — variables de entorno de esta instancia.
# Basado en gueo-back-end/.env.example; el detalle de cada variable está en
# gueo-back-end/docs/environment-variables.md. NUNCA subas valores reales.
#
# SERVER_PORT y NODE_ENV no van aquí: los fijan el compose (3000) y la imagen (prod).
# Dentro del contenedor 127.0.0.1 es el propio contenedor.


# --- HTTP e identidad ---
# URL pública base del sistema, con esquema. Ver "Riesgos conocidos" en el README.
IP_SERVER=http://CAMBIAR-direccion-del-servidor


# --- Conexión con s0 (backend-s0) ---
# URL con la que s1 llama a s0. Dentro de la red privada de la instancia, s0 se resuelve por el
# nombre del servicio. Requiere una imagen de gueo-back-end con soporte de AUTH_URL.
# Si s0 no corre en esta instancia, apunta aquí al Auth que corresponda.
AUTH_URL=http://s0:3200


# --- Autenticación (únicos por instancia) ---
JWT_SECRET=
# Mínimo 32 caracteres. Sin él, el endpoint de handoff responde 503.
DELTA_UNIVERSITY_HANDOFF_SECRET=


# --- Bases de datos (MongoDB del servidor, visto desde el contenedor) ---
# Tres conexiones independientes; usa nombres de base propios de la instancia.
MONGO_DELTA_DISPATCH_URI=mongodb://host.docker.internal:27017/CAMBIAR_deltadispatch_INSTANCIA
MONGO_AUTHSOFTWARE_URI=mongodb://host.docker.internal:27017/CAMBIAR_authsoftware_INSTANCIA
MONGO_ROBIN_URI=mongodb://host.docker.internal:27017/CAMBIAR_robin_INSTANCIA


# --- Conexión TCP interna ---
IP_INTERNAL_CONNECTION=127.0.0.1
# main.ts hoy ignora este valor (el puerto es fijo en 5020).
PORT_INTERNAL_CONNECTION=5020
# Dirección en la que escucha el microservicio TCP (5020) que usa s0. Sin esta variable escucha
# solo en 127.0.0.1 y s0, en otro contenedor, no lo alcanza. 0.0.0.0 = visible en la red privada
# de la instancia (el puerto NO se publica). Requiere una imagen de gueo-back-end con TCP_LISTEN_HOST.
TCP_LISTEN_HOST=0.0.0.0


# --- Firebase y notificaciones push ---
# Rutas DENTRO del contenedor: el compose monta instances/<instancia>/secrets en /run/secrets.
# Copia ahí los dos JSON de cuenta de servicio con estos nombres (o cambia las rutas).
FCM_CERT=/run/secrets/fcm.json
KEEPER_FCM_CERT=/run/secrets/keeper-fcm.json
API_KEY_CLOUD_MESSAGING=


# --- Federación ---
# Base64 de exactamente 32 bytes (por ejemplo: openssl rand -base64 32). Único por instancia.
FEDERATION_ENCRYPTION_KEY=
FEDERATION_NODE_DISPLAY_NAME=Delta Federation Node


# --- Webhook de WhatsApp ---
# Texto JSON en UNA línea y SIN comillas alrededor. Con [] basta para arrancar.
SERVERS_CONFIG=[]
VERIFY_TOKEN=keeper_wsp_bussiness_app


# --- Servicios de terceros ---
GOOGLE_KEY=
# Obligatoria en el primer arranque con la base vacía (cualquier valor arranca; la transcripción real necesita una válida).
DEEPGRAM_API_KEY=
TRANSCRIPTOR_URL=


# --- Push-to-talk (LiveKit) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600


# --- Exportación de turnos ---
# Cámbiala en producción (por defecto: shift-update-baseline).
SHIFT_UPDATE_BASELINE_SECRET=


# --- Banderas de funcionalidad (desactivadas por defecto) ---
# SUPERVISOR_REPORT_PARITY_CHECK=log
# SIPCOP_ALERT_RESYNC=on
