# s0 = auth-backend — variables de entorno de esta instancia.
# Basado en auth-backend/.env.example; el detalle de cada variable está en
# auth-backend/docs/environment-variables.md. NUNCA subas valores reales.
#
# SERVER_PORT no va aquí: lo fija el compose (3200).
# Dentro del contenedor 127.0.0.1 es el propio contenedor.


# --- Servidor ---
# URL pública base del sistema, con esquema. Ver "Riesgos conocidos" en el README.
IP_SERVER=http://CAMBIAR-direccion-del-servidor


# --- Autenticación (únicos por instancia) ---
JWT_SECRET=
JWT_EXPIRES_IN=8h


# --- Base de datos ---
# MongoDB del servidor, visto desde el contenedor. Usa un nombre de base propio de la instancia.
MONGO_URI=mongodb://host.docker.internal:27017/CAMBIAR_authsoftware_INSTANCIA


# --- Conexión con s1 (gueo-back-end) ---
# Host del servidor TCP de s1; el código usa el puerto fijo 5020. Dentro de la red de la
# instancia se resuelve por el nombre del servicio, sin publicar el puerto.
IP_INTERNAL_CONNECTION=s1
GOOGLE_KEY=


# --- Propagación de perfiles ---
PROFILE_PROPAGATION_ENABLED=true
PROFILE_SYNC_CONCURRENCY=4
PROFILE_BACKUP_DIR=./backups
