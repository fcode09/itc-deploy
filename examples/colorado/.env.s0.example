# EJEMPLO de .env.s0 (auth-backend) para la municipalidad "colorado", ya completado.
# Todos los valores son ficticios: genera los tuyos. NUNCA subas el archivo real.
# SERVER_PORT no va aquí: lo fija el compose (3200).


# --- Servidor ---
# URL pública base del sistema, con esquema. 203.0.113.10 es una dirección de documentación.
# Ver "Riesgos y pendientes conocidos" en el README sobre cómo se usa esta variable.
IP_SERVER=http://203.0.113.10


# --- Autenticación (único por instancia; genera uno con: openssl rand -hex 32) ---
JWT_SECRET=ejemplo-jwt-colorado-no-usar-en-produccion
JWT_EXPIRES_IN=8h


# --- Base de datos ---
# MongoDB del servidor visto desde el contenedor; base propia de la instancia.
MONGO_URI=mongodb://host.docker.internal:27017/colorado_authsoftware


# --- Conexión con s1 (gueo-back-end) ---
# Dentro de la red de la instancia, s1 se resuelve por el nombre del servicio.
IP_INTERNAL_CONNECTION=s1
GOOGLE_KEY=ejemplo-google-maps-key


# --- Propagación de perfiles ---
PROFILE_PROPAGATION_ENABLED=true
PROFILE_SYNC_CONCURRENCY=4
PROFILE_BACKUP_DIR=./backups
