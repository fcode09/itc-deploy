# EJEMPLO de .env.instance para una municipalidad nueva ("colorado"), ya completado.
# Todos los valores son ficticios. En una instancia real este archivo vive en
# instances/colorado/.env.instance y NO se sube al repositorio.

# Nombre de la instancia: minúsculas, números y guion. Debe coincidir con el de la carpeta.
INSTANCE=colorado

# Servicios activos en esta instancia: s0 = backend-s0, s1 = backend-s1.
COMPOSE_PROFILES=s0,s1

# Registry de las imágenes: VACÍO porque las imágenes ya están cargadas en el Docker del servidor
# (docker load / ./deltactl load). Se usan como backend-s0:1.4.0 y backend-s1:2.7.1.
REGISTRY=

# Nombre de la imagen de cada servicio (sin etiqueta ni registry). Son los valores por defecto.
S0_IMAGE=backend-s0
S1_IMAGE=backend-s1

# Etiquetas de imagen a desplegar: una por versión o commit, nunca "latest".
S0_TAG=1.4.0
S1_TAG=2.7.1

# Puertos del host (solo 127.0.0.1). Esta sería la 1.ª instancia: bloque 4100.
# La 2.ª usaría 4110/4111, la 3.ª 4120/4121, y así.
S0_PORT=4100
S1_PORT=4101

# Límites de memoria. s1 incluye Chromium para los reportes PDF.
S0_MEM_LIMIT=512m
S1_MEM_LIMIT=2g

# Techos de CPU en núcleos: al pasarlos el servicio se ralentiza, no se cae. Ajusta a los núcleos del servidor.
S0_CPUS=0.5
S1_CPUS=1
