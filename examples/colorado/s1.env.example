# EJEMPLO de s1.env (gueo-back-end) para la municipalidad "colorado", ya completado.
# Todos los valores son ficticios: genera los tuyos. NUNCA subas el archivo real.
# SERVER_PORT y NODE_ENV no van aquí: los fijan el compose (3000) y la imagen (prod).


# --- HTTP e identidad ---
# URL pública base del sistema, con esquema (dirección de documentación).
IP_SERVER=http://203.0.113.10


# --- Autenticación (únicos por instancia) ---
JWT_SECRET=ejemplo-jwt-colorado-no-usar-en-produccion
# Mínimo 32 caracteres. Sin él, el endpoint de handoff responde 503.
DELTA_UNIVERSITY_HANDOFF_SECRET=ejemplo-handoff-colorado-minimo-32-caracteres


# --- Bases de datos (MongoDB del servidor, visto desde el contenedor) ---
# Tres conexiones independientes; un nombre de base propio por instancia.
MONGO_DELTA_DISPATCH_URI=mongodb://host.docker.internal:27017/colorado_deltadispatch
MONGO_AUTHSOFTWARE_URI=mongodb://host.docker.internal:27017/colorado_authsoftware
MONGO_ROBIN_URI=mongodb://host.docker.internal:27017/colorado_robin


# --- Conexión TCP interna ---
IP_INTERNAL_CONNECTION=127.0.0.1
# main.ts hoy ignora este valor (el puerto es fijo en 5020).
PORT_INTERNAL_CONNECTION=5020


# --- Firebase y notificaciones push ---
# Rutas DENTRO del contenedor: instances/colorado/secrets/ se monta en /run/secrets.
FCM_CERT=/run/secrets/fcm.json
KEEPER_FCM_CERT=/run/secrets/keeper-fcm.json
API_KEY_CLOUD_MESSAGING=


# --- Federación ---
# Base64 de exactamente 32 bytes. Este valor es de EJEMPLO; genera uno con: openssl rand -base64 32
FEDERATION_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
FEDERATION_NODE_DISPLAY_NAME=Colorado


# --- Webhook de WhatsApp ---
# Texto JSON en UNA línea y SIN comillas alrededor. Con [] basta para arrancar.
SERVERS_CONFIG=[]
VERIFY_TOKEN=keeper_wsp_bussiness_app


# --- Servicios de terceros ---
GOOGLE_KEY=ejemplo-google-maps-key
# Obligatoria en el primer arranque con la base vacía (cualquier valor arranca; la transcripción real necesita una válida).
DEEPGRAM_API_KEY=ejemplo-deepgram-key
TRANSCRIPTOR_URL=


# --- Push-to-talk (LiveKit) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600


# --- Exportación de turnos ---
# Cámbiala en producción (por defecto: shift-update-baseline).
SHIFT_UPDATE_BASELINE_SECRET=ejemplo-baseline-colorado


# --- Banderas de funcionalidad (desactivadas por defecto) ---
# SUPERVISOR_REPORT_PARITY_CHECK=log
# SIPCOP_ALERT_RESYNC=on
