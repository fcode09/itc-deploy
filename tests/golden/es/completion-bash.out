# deltactl: bash completion (generated by ./deltactl completion bash)
_deltactl_complete() {
  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="${COMP_WORDS[1]:-}" prev="${COMP_WORDS[COMP_CWORD-1]}"
  local cmds="new init adopt deploy rollback stop down load images versions list status runs ps logs check doctor env menu completion help" topics="nueva-instancia instancia-existente actualizar imagenes servicios red datos secretos archivos puertos solucion-problemas glosario" services="s0 s1" vars="API_KEY_CLOUD_MESSAGING AUTH_URL COMPOSE_PROFILES DATA_DIR DEEPGRAM_API_KEY DELTA_UNIVERSITY_HANDOFF_SECRET FCM_CERT FEDERATION_ENCRYPTION_KEY FEDERATION_NODE_DISPLAY_NAME GOOGLE_KEY INSTANCE IP_INTERNAL_CONNECTION IP_SERVER JWT_EXPIRES_IN JWT_SECRET KEEPER_FCM_CERT LIVEKIT_API_KEY LIVEKIT_API_SECRET LIVEKIT_TOKEN_TTL_SECONDS LIVEKIT_URL MONGO_AUTHSOFTWARE_URI MONGO_DELTA_DISPATCH_URI MONGO_ROBIN_URI MONGO_URI NODE_ENV PORT_INTERNAL_CONNECTION PROFILE_BACKUP_DIR PROFILE_PROPAGATION_ENABLED PROFILE_SYNC_CONCURRENCY REGISTRY S0_IMAGE S0_MEM_LIMIT S0_PORT S0_TAG S1_IMAGE S1_MEM_LIMIT S1_PORT S1_TAG SERVERS_CONFIG SERVER_PORT SHIFT_UPDATE_BASELINE_SECRET SIPCOP_ALERT_RESYNC SUPERVISOR_REPORT_PARITY_CHECK TCP_LISTEN_HOST TRANSCRIPTOR_URL VERIFY_TOKEN "
  local insts="" f flags=""
  for f in "<ROOT>"/instances/*/.env.instance; do
    [ -f "$f" ] && insts+="$(basename "$(dirname "$f")") "
  done
  COMPREPLY=()

  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$cmds menu completion" -- "$cur"))
    return 0
  fi

  case "$cmd" in
    new) flags="--services --existing --wizard --s0-image --s1-image --s0-tag --s1-tag --ip --generate-secrets" ;;
    init) flags="--yes" ;;
    doctor) flags="--json" ;;
    rollback) flags="--yes" ;;
    down) flags="--yes" ;;
    status) flags="--json --stats --strict --watch" ;;
    images) flags="--json" ;;
    versions) flags="--json" ;;
    check) flags="--mongo" ;;
    logs) flags="-f" ;;
    menu) flags="--classic" ;;
    runs) flags="--instance -n --json --tail --raw" ;;
    env) flags="--reveal --json --stdin --force --yes" ;;
  esac
  if [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "$flags" -- "$cur"))
    return 0
  fi

  case "$cmd" in
    help)
      if [ "$prev" = "variable" ] || [ "$prev" = "variables" ]; then
        COMPREPLY=($(compgen -W "$vars" -- "$cur"))
      elif [ "$COMP_CWORD" -eq 2 ]; then
        COMPREPLY=($(compgen -W "$cmds $topics variable buscar temas" -- "$cur"))
      fi ;;
    deploy | rollback | stop | logs | check | status)
      if [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=($(compgen -W "$insts" -- "$cur"))
      elif [ "$COMP_CWORD" -eq 3 ]; then COMPREPLY=($(compgen -W "$services" -- "$cur")); fi ;;
    init | adopt | down | ps)
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$insts" -- "$cur")) ;;
    images | versions)
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$services" -- "$cur")) ;;
    load)
      COMPREPLY=($(compgen -f -- "$cur")) ;;
    env)
      if [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=($(compgen -W "$insts" -- "$cur"))
      elif [ "$COMP_CWORD" -eq 3 ]; then COMPREPLY=($(compgen -W "list get set generate pending" -- "$cur"))
      elif [ "$COMP_CWORD" -eq 4 ]; then
        case "${COMP_WORDS[3]}" in
          list) COMPREPLY=($(compgen -W "instance $services" -- "$cur")) ;;
          get | set | generate) COMPREPLY=($(compgen -W "$vars" -- "$cur")) ;;
        esac
      fi ;;
    runs)
      if [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=($(compgen -W "list show logs stats resolve prune" -- "$cur")); fi ;;
    completion)
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "bash" -- "$cur")) ;;
  esac
  return 0
}
complete -F _deltactl_complete deltactl ./deltactl "<ROOT>/deltactl"
[exit=0]
