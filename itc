#!/usr/bin/env bash
# itc: punto de entrada para desplegar y operar instancias. Ver ./itc help
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ROOT

# shellcheck source=scripts/lib.sh
source "$ROOT/scripts/lib.sh"

# Sin argumentos: en una terminal, pantalla de inicio (banner + estado); en un pipe o script, la ayuda.
if [ "$#" -eq 0 ] && [ "$UI_RICH" -eq 1 ]; then
  # shellcheck source=scripts/cmd/status.sh
  source "$ROOT/scripts/cmd/status.sh"
  cmd_home
  exit 0
fi

CMD="${1:-help}"
shift 2>/dev/null || true
export CMD

# <comando> --help | -h: ayuda de ese comando (la detección es previa a ejecutar nada).
case "$CMD" in
  help | -h | --help) ;;
  *)
    for _a in "$@"; do
      case "$_a" in
        -h | --help)
          # shellcheck source=scripts/cmd/help.sh
          source "$ROOT/scripts/cmd/help.sh"
          cmd_help "$CMD"
          exit $?
          ;;
      esac
    done
    ;;
esac

case "$CMD" in
  new | deploy | rollback | list | images | load | status | check | doctor)
    # shellcheck source=/dev/null
    source "$ROOT/scripts/cmd/$CMD.sh"
    "cmd_$CMD" "$@"
    ;;
  versions)
    # Alias de images.
    # shellcheck source=scripts/cmd/images.sh
    source "$ROOT/scripts/cmd/images.sh"
    cmd_images "$@"
    ;;
  init | adopt)
    # shellcheck source=scripts/cmd/init.sh
    source "$ROOT/scripts/cmd/init.sh"
    "cmd_$CMD" "$@"
    ;;
  ps | logs | stop | down)
    # shellcheck source=scripts/cmd/ops.sh
    source "$ROOT/scripts/cmd/ops.sh"
    "cmd_$CMD" "$@"
    ;;
  help | -h | --help)
    # shellcheck source=scripts/cmd/help.sh
    source "$ROOT/scripts/cmd/help.sh"
    cmd_help "$@"
    ;;
  *)
    warn "comando desconocido: $CMD"
    info "Prueba: ./itc help      (comandos y guías)   |   ./itc help buscar $CMD" >&2
    exit 1
    ;;
esac
