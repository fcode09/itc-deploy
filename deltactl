#!/usr/bin/env bash
# deltactl: entry point to deploy and operate instances. See ./deltactl help
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export ROOT

# shellcheck source=lib/bootstrap.sh
source "$ROOT/lib/bootstrap.sh"

# No arguments: in a terminal, the interactive panel (the static home screen when the terminal cannot run it);
# in a pipe or script, the help.
if [ "$#" -eq 0 ] && [ "$UI_RICH" -eq 1 ]; then
  # shellcheck source=lib/cmd/dashboard.sh
  source "$ROOT/lib/cmd/dashboard.sh"
  cmd_dashboard
  exit 0
fi

CMD="${1:-help}"
shift 2>/dev/null || true
export CMD

# <command> --help | -h: help for that command (detected before running anything).
case "$CMD" in
  help | -h | --help) ;;
  *)
    for _a in "$@"; do
      case "$_a" in
        -h | --help)
          # shellcheck source=lib/cmd/help.sh
          source "$ROOT/lib/cmd/help.sh"
          cmd_help "$CMD"
          exit $?
          ;;
      esac
    done
    ;;
esac

# Operations that change something run recorded: their own log, a lock against a second operation and an entry in the history
# (lib/core/runs.sh). DELTACTL_NO_RUNS=1 turns it off; DELTACTL_RUN_ID is set inside a recorded run, so it is not wrapped twice.
if [ "${DELTACTL_NO_RUNS:-0}" != "1" ]; then
  # shellcheck source=lib/core/runs.sh
  source "$ROOT/lib/core/runs.sh"
  if [ -z "${DELTACTL_RUN_ID:-}" ]; then
    if runs_is_mutation "$CMD" "$@"; then runs_exec "$CMD" "$@"; fi
  else
    runs_child_init   # inside the record: every call to docker is timed
  fi
fi

case "$CMD" in
  new | deploy | rollback | list | images | load | status | check | doctor | menu | completion | runs)
    # shellcheck source=/dev/null
    source "$ROOT/lib/cmd/$CMD.sh"
    "cmd_$CMD" "$@"
    ;;
  versions)
    # Alias of images.
    # shellcheck source=lib/cmd/images.sh
    source "$ROOT/lib/cmd/images.sh"
    cmd_images "$@"
    ;;
  init | adopt)
    # shellcheck source=lib/cmd/init.sh
    source "$ROOT/lib/cmd/init.sh"
    "cmd_$CMD" "$@"
    ;;
  ps | logs | stop | down)
    # shellcheck source=lib/cmd/ops.sh
    source "$ROOT/lib/cmd/ops.sh"
    "cmd_$CMD" "$@"
    ;;
  help | -h | --help)
    # shellcheck source=lib/cmd/help.sh
    source "$ROOT/lib/cmd/help.sh"
    cmd_help "$@"
    ;;
  *)
    warn "$(t cli.unknown_command "$CMD")"
    info "$(t cli.try_help "$CMD")" >&2
    exit 1
    ;;
esac
